{%- set proxies = [] -%}
{%- for p in proxybridge_proxies -%}
{%-   set _ = proxies.append({
        "Id": p.id | int,
        "Name": p.name | default(""),
        "Type": p.type | upper,
        "Host": p.host,
        "Port": p.port | string,
        "Username": p.username | default(""),
        "Password": p.password | default(""),
        "SendDomainToProxy": p.send_domain | default(true) | bool,
      }) -%}
{%- endfor -%}
{%- set rules = [] -%}
{%- for r in proxybridge_rules -%}
{%-   set _ = rules.append({
        "Name": r.name | default(""),
        "ProcessName": r.process | default("*"),
        "TargetHosts": r.hosts | default("*"),
        "TargetPorts": r.ports | default("*") | string,
        "Protocol": r.protocol | default("BOTH") | upper,
        "Action": r.action | default("PROXY") | upper,
        "IsEnabled": r.enabled | default(true) | bool,
        "ProxyConfigId": r.proxy_id | default(0) | int,
        "LocalhostViaProxy": r.localhost | default(false) | bool,
      }) -%}
{%- endfor -%}
{{ {
  "Version": "1.0",
  "Name": "ansible",
  "IsTrafficLoggingEnabled": (proxybridge_verbose | int) >= 2,
  "DnsViaProxy": proxybridge_dns_via_proxy | bool,
  "ProxyConfigs": proxies,
  "ProxyRules": rules,
} | to_nice_json(indent=2) }}
