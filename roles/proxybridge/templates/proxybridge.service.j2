{% macro arg(value) -%}
"{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') | replace('$', '$$') }}"
{%- endmacro %}
[Unit]
Description=ProxyBridge
Documentation=file:///usr/share/doc/proxybridge/README.md
After=network-online.target
Wants=network-online.target

[Service]
# Headless CLI with a profile rendered by ansible, not the GUI daemon
# (ProxyBridge --daemon). The eBPF hooks go away with the process, so there is
# nothing to clean up on stop.
# stdbuf: stdout is a pipe to the journal, without it logs show up in blocks
ExecStart=/usr/bin/stdbuf -oL /usr/bin/ProxyBridge \
    --profile {{ arg(proxybridge_profile_path) }} \
    --verbose {{ proxybridge_verbose | int }}{% for extra in proxybridge_extra_args %} \
    {{ arg(extra) }}{% endfor %}

Restart=on-failure
RestartSec=5
LimitNOFILE=1048576

# sandbox from the upstream unit (ProxyBridge --print-unit)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
UMask=0077
MemoryMax=1G
TasksMax=512
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH

[Install]
WantedBy=multi-user.target
